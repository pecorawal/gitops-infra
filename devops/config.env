# ---------------------------------------------------------------------------
#  Parâmetros da demo DevOps — único lugar a editar.
#  Lido por devops/scripts/preparar.sh e devops/demo/etapa.sh.
#  NÃO coloque tokens aqui: eles entram por variável de ambiente.
# ---------------------------------------------------------------------------

# Quay no CLUSTER GERENCIADO (host da rota, sem https://) e organização
QUAY_HOST="quay-registry-quay-quay-enterprise.apps.<cluster-gerenciado>.<dominio>"
QUAY_ORG="puc"

# Nome do cluster gerenciado no ACM (oc get managedcluster)
CLUSTER_GERENCIADO="<cluster-gerenciado>"

# Contextos do oc (oc config get-contexts). Mesma convenção do acm-demo.
HUB_CTX="hub"
GER_CTX="gerenciado"
