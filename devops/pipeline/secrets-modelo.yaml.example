# ---------------------------------------------------------------------------
#  CREDENCIAIS DA ESTEIRA  —  MODELO, NÃO COMITE VALORES REAIS
# ---------------------------------------------------------------------------
#  São três Secrets no namespace devops-ci. O jeito mais simples é deixar o
#  script criar a partir de variáveis de ambiente (nada vai para o Git):
#
#    export QUAY_PUSH_USER='<org>+devops_ci'   QUAY_PUSH_TOKEN='<token>'
#    export GITHUB_TOKEN='<PAT com permissão de push no repo>'
#    ./devops/scripts/preparar.sh secrets
#
#  1. quay-push            robot account do Quay (cluster gerenciado) com
#                          permissão WRITE no repositório pagamentos-api.
#                          Montado como workspace "dockerconfig" do buildah.
#  2. github-token         token usado pela task update-gitops para fazer o
#                          commit da nova tag no repositório GitOps.
#  3. github-webhook       segredo compartilhado com o webhook do GitHub
#                          (o EventListener rejeita chamadas sem ele).
#
#  Alternativa com External Secrets Operator (como em
#  pagamentos-api-app-gitops/ci/00-gitops-token-es.yaml): troque o Secret
#  github-token por um ExternalSecret apontando para o seu ClusterSecretStore.
# ---------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: github-token
  namespace: devops-ci
type: Opaque
stringData:
  token: "<PREENCHER>"
---
apiVersion: v1
kind: Secret
metadata:
  name: github-webhook
  namespace: devops-ci
type: Opaque
stringData:
  secret: "<PREENCHER>"
---
# quay-push: crie com
#   oc -n devops-ci create secret docker-registry quay-push \
#     --docker-server=<QUAY_HOST> --docker-username='<org>+devops_ci' --docker-password='<token>'
